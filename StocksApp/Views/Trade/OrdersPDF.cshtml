@model OrdersViewModel
@{
    Layout = null;
}

<link href="@("http://" + Context.Request.Host.ToString() + "/css/Stylesheet.css")" rel="stylesheet" />

<table class="table w-100 mt">
    <thead>
        <tr>
            <th>Date and Time</th>
            <th>Stock</th>
            <th>Order Type</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Trade Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (BuyOrderResponse bo in Model.BuyOrders)
        {
            <tr>
                <td width="18%">@bo.DateAndTimeOfOrder</td>
                <td width="20%">@bo.StockName</td>
                <td width="10%">BuyOrder</td>
                <td width="9%">@bo.Quantity</td>
                <td width="9%">$ @bo.Price</td>
                <td width="13%">@bo.TradeAmount</td>
            </tr>
        }

        @foreach (SellOrderResponse so in Model.SellOrders)
        {
            <tr>
                <td width="18%">@so.DateAndTimeOfOrder</td>
                <td width="20%">@so.StockName</td>
                <td width="10%">SellOrder</td>
                <td width="9%">@so.Quantity</td>
                <td width="9%">$ @so.Price</td>
                <td width="13%">@so.TradeAmount</td>
            </tr>
        }
    </tbody>
</table>

